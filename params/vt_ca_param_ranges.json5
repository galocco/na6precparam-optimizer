      "min": 0,
      "max": 0.5,
      "type": "float",
      "iterations_param": "vtNIterationsTrackerCA",
      "monotone_increasing": true 
    },
    "vtMaxDeltaPyPzCellsCA": {
      "min": 0.0,
      "max": 0.01,
      "type": "float",
      "iterations_param": "vtNIterationsTrackerCA",
      "monotone_increasing": true 
    },
    "vtMaxChi2TrClCellsCA": {
      "min": 0,
      "max": 50,
      "type": "float",
      "iterations_param": "vtNIterationsTrackerCA",
      "monotone_increasing": true 
