{
  "reco_options": {
    "doHitsToRecPoints": true,
    "doDigitsToRecPoints": false,
    "doTrackletVertex": false,
    "doVTTracking": true,
    "allowHolesInVTTracks": true,
    "doMSTracking": false,
    "doMatching": false
  },
